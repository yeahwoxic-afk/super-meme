# Copy to `.env` (same folder) and fill in. Never commit `.env`.
# Address of your NutriAI server (Render gives it after deploy), no trailing slash:
EXPO_PUBLIC_API_URL=https://nutri-ai-api.onrender.com
# Same value as APP_API_TOKEN in the Render dashboard:
EXPO_PUBLIC_API_TOKEN=paste-the-token-here
